# Eclipse OS — cabeceras para la página «En vivo», si el servidor es Apache
# (necesita mod_headers y AllowOverride FileInfo). Para nginx, ver
# deploy/nginx-live.conf. El porqué está explicado allí.
<IfModule mod_headers.c>
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Embedder-Policy "credentialless"
  Header always set Cross-Origin-Resource-Policy "same-origin"
</IfModule>
AddType application/wasm .wasm
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE application/wasm application/javascript application/json text/css
</IfModule>
